{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    // Source files import each other with explicit .ts specifiers so Node's
    // type-stripping test runner can resolve them; this rewrites those to .js
    // in the emitted output.
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "dist"]
}
