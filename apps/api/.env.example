# Postgres connection (Dokploy creates this for you)
DATABASE_URL=postgres://ironlog:password@localhost:5432/ironlog

# Secret used to sign sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me

# Public URL the API is reachable at — must match exactly, including scheme.
# OAuth callbacks and cookie domains are derived from this.
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated origins allowed to call the API.
# The mobile app's deep-link scheme must be listed for OAuth to return.
TRUSTED_ORIGINS=ironlog://,http://localhost:8081

PORT=3000

# Optional social sign-in. Apple is required by App Store guideline 4.8
# if you ship any other social provider.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
