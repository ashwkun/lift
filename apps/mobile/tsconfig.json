{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    // The app consumes @lift/shared as raw TypeScript source, and those
    // modules import each other with explicit .ts extensions so Node's
    // type-stripping test runner can resolve them without a build step.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      // Local Expo modules. Their JS half is ordinary source that Metro bundles
      // like any other file; only the native half is linked by Gradle.
      "@modules/*": ["./modules/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../packages/shared/src/**/*.ts"
  ],
  // The shared package's tests run under Node with @types/node; the app has no
  // Node typings and shouldn't be compiling them anyway.
  "exclude": ["node_modules", "../../packages/shared/src/**/*.test.ts"]
}
