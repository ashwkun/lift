<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's plate.

  White would be the obvious choice for something that is always recoloured at
  runtime, but this drawable is also what the widget picker renders through
  `previewLayout`, and there the tint has not happened yet. So the fill is the
  default theme's `surface` — the same value `WidgetPalette` falls back to — and
  the picker shows the widget as most people will actually see it.

  The corner radius is aliased per API level in `values/dimens.xml`.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
  <solid android:color="#1A1A1A" />
  <corners android:radius="@dimen/widget_radius" />
</shape>
