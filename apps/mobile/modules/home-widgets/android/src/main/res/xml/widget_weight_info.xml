<?xml version="1.0" encoding="utf-8"?>
<!--
  Sizing, in the two vocabularies Android has used for it.

  `targetCellWidth`/`targetCellHeight` are the real answer and are read from
  Android 12; `minWidth`/`minHeight` are what every launcher before that reads,
  in the dp a cell grid works out to (70n − 30). Both are given because dropping
  either silently changes the default size on half the devices this runs on.

  Three cells wide rather than two: the value is the point of this widget and
  "105.2 lb" at a readable size does not fit in 110dp.

  `updatePeriodMillis="0"` — nothing here decays with time. The tile changes when
  a weigh-in is logged, and the app pushes it then. A polling interval would wake
  the process to redraw the same three strings.

  No `previewImage`. `previewLayout` covers Android 12 and up, and below that the
  picker falls back to the app icon, which is a worse preview than the real thing
  but not a broken one. The alternative is a hand-drawn bitmap of a widget that
  is themed, which would be wrong for seven of the eight palettes.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_weight"
    android:previewLayout="@layout/widget_weight"
    android:description="@string/widget_weight_description"
    android:widgetCategory="home_screen" />
