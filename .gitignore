node_modules/
dist/
build/
.expo/
.expo-shared/
web-build/

# native
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
# Anchored to the app root on purpose. Unanchored, `android/` matches at every
# depth — including `apps/mobile/modules/*/android/`, which is hand-written
# source rather than prebuild output, and which git would then drop from every
# commit without saying so.
/apps/mobile/android/
/apps/mobile/ios/
# The repo root is not an Expo project, so anything here by these names is
# prebuild output from a command run one directory too high. Named explicitly
# because anchoring the rules above stopped covering them.
/android/
/ios/

# env
.env
.env.*
!.env.example

# logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# os / editor
.DS_Store
.idea/
*.swp

# drizzle
drizzle/meta/_journal.json.bak

# build output
packages/shared/dist/
