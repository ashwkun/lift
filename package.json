{
  "name": "lift",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "mobile": "pnpm --filter @lift/mobile start",
    "android": "pnpm --filter @lift/mobile android",
    "ios": "pnpm --filter @lift/mobile ios",
    "api": "pnpm --filter @lift/api start:dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "dependencies": {
    "expo": "~57.0.7",
    "react": "19.2.3",
    "react-native": "0.86.0"
  }
}
