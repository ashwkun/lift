# The API image builds from the workspace root, so without this the whole
# repository — a gigabyte of node_modules included — is sent to the daemon on
# every build.

node_modules
**/node_modules

# Host build output. The image compiles its own from source.
dist
**/dist
build
**/build
packages/shared/dist

# Native projects, regenerated by `expo prebuild` and never part of the API.
android
ios
.expo
**/.expo

# The Dockerfile copies packages/shared and apps/api only.
apps/mobile

.git
.github
docs
scripts

# Secrets are supplied as environment variables, never baked into a layer.
.env
**/.env
**/.env.*

*.log
.idea
.DS_Store
