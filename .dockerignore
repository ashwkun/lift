# Both images build from the workspace root, so without this the whole
# repository — a gigabyte of node_modules included — is sent to the daemon on
# every build.

node_modules
**/node_modules

# Host build output. The image compiles its own from source.
dist
**/dist
build
**/build
packages/shared/dist

# Next's build output and its dev cache. Left in, a local `pnpm landing build`
# adds a few hundred megabytes to the context of every image built from this
# repository, including the two that have nothing to do with it.
.next
**/.next

# Native projects, regenerated by `expo prebuild` and part of no image. Written
# out one path at a time rather than as `**/android`, which would also match
# `apps/mobile/modules/*/android` — hand-written Kotlin, not prebuild output.
# The same distinction the root .gitignore makes, for the same reason.
android
ios
apps/mobile/android
apps/mobile/ios
.expo
**/.expo

# apps/mobile is *not* excluded: the web image builds from it. The API image
# never copies it, so all it costs there is a few megabytes of build context.

.git
.github
docs
scripts

# Secrets are supplied as environment variables, never baked into a layer.
.env
**/.env
**/.env.*

*.log
.idea
.DS_Store
